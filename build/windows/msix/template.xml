<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lingo-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\ProjectErotic\Lingo Translate">
    </Installer>
    <PackageInformation
        PackageName="Lingo Translate"
        PackageDisplayName="Lingo Translate"
        PublisherName="CN=ProjectErotic"
        PublisherDisplayName="ProjectErotic"
        Version="0.1.0.0"
        PackageDescription="Lingo Translate - Game Translation Suite">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.projecterotic.lingo"
                Description="Lingo Translate - Game Translation Suite"
                DisplayName="Lingo Translate"
                ExecutableName="lingo-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lingo Translate</DisplayName>
            <PublisherDisplayName>ProjectErotic</PublisherDisplayName>
            <Description>Lingo Translate - Game Translation Suite</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lingo-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>

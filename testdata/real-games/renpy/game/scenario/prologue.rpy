    scene bg null with None
    $ loopplay("transformend")
    $ push_in("ch_0_39")

    "Но прямо сейчас передо мной происходило невозможное - настоящее обращение."
    "В голове роились десятки вопросов.{w=0.4} Почему она не погибла?{w=0.4} Воля к жизни?{w=0.4} Сильное сердце?"
    "Бред собачий... Тела у всех людей одинаковы, даже гораздо более сильные и выносливые воины не могли справиться с этим."

    $ loopstop()
    pause 1
    $ splay("tobed")

    "Обращение наконец закончилось."
    "Похоже, боль ее была адской, ибо под конец процесса девушка попросту потеряла сознание."
    "Поколебавшись, я положил ее на диван, надеясь, что может она скоро очнется."

    scene bg null with dissolve

    hero_m "Но... Что дальше?"
    hero_m "Если она действительно стала вампиром, может я смогу использовать её, чтобы выбраться из этой дыры."
    hero_m "Да, мысль неплохая."
    hero_m "Выживи, незнакомка. Теперь у меня на тебя большие планы..."

    hide text

    $ mstop()
    scene black with Dissolve (2.0)

    show text _("{size=+10}Глава первая{/size}\n{size=+16}{color=#b31b3b}{outlinecolor=#180000}{shader=jitter:u__jitter=1.8, 2.2}Отрицание{/shader}{/outlinecolor}{/color}{/size}") at prologue_fade_text:
        align (0.5, 0.45)

    $ renpy.pause(6.0, hard=True)
    hide text

    jump glava_1




transform vampire_word_reveal:
    alpha 0.0
    zoom 1.25
    blur 16

    linear 1.0 alpha 1.0 zoom 1.0 blur 0

    pause 0.15

    block:
        linear 0.04 xoffset -1 yoffset 0
        linear 0.04 xoffset 1 yoffset 0
        linear 0.04 xoffset 0 yoffset -1
        linear 0.04 xoffset 0 yoffset 1
        linear 0.04 xoffset 0 yoffset 0
        pause 0.7
        repeat

transform prologue_fade_text:
    subpixel True
    alpha 0.0
    zoom 0.85

    ease 2.0 alpha 1.0 zoom 1.0
    pause 2.0
    ease 2.0 alpha 0.0 zoom 1.15


screen vampire_word_screen():

    zorder 100

    fixed:
        xfill True
        yfill True

        text _("\n{i}{k=2} Вампир. {/k}{/i}\n"):
            xalign 0.5
            yalign 0.485

            xsize 1200
            ysize 400

            text_align 0.5
            line_spacing 40

            font "font/pen.ttf"
            size gui.text_size + 24
            color "#8b0000"
            outlines [ (2, "#260000", 0, 0), (1, "#d66", 0, 0) ]

            at vampire_word_reveal




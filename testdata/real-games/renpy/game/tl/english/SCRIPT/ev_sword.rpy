# game/SCRIPT/ev_sword.rpy:3
translate english ev_sword_6728fee2:

    # "{#c}{image=img fire}"
    "{#c}{image=img fire}"

# game/SCRIPT/ev_sword.rpy:10
translate english ev_sword_feae39a8:

    # raz "Любопытная какая. И что же ты там надеешься найти?"
    raz "Aren't we curious. And what exactly do you expect to find?"

# game/SCRIPT/ev_sword.rpy:23
translate english ev_sword_49650928:

    # ss "Ты прав только в одном: здесь ты один. И умирать будешь тоже один."
    ss "You are right about only one thing: you are alone here. And you will die alone, too."

# game/SCRIPT/ev_sword.rpy:30
translate english ev_sword_330bde03:

    # raz "Вампир! Вот уж на кого черти вынесли... Ну, с тобой не позабавишься. Ступай-ка ты в ад, откуда пришла!"
    raz "Vampire! Speak of the devil... Well, you're no fun. Go straight to hell where you belong!"

# game/SCRIPT/ev_sword.rpy:36
translate english ev_sword_6b923fd3:

    # ss "Ты бы меня не пощадил!"
    ss "You would never have shown me mercy!"


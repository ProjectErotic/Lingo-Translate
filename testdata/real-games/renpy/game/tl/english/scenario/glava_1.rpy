    # game/scenario/glava_1.rpy:598
    old "В вагину"
    new "Pussy"

    # game/scenario/glava_1.rpy:612
    old "Кончить внутрь"
    new "Cum inside"

    # game/scenario/glava_1.rpy:616
    old "Кончить наружу"
    new "Cum outside"

